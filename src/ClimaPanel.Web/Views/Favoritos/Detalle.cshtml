@model FavoriteDetailsViewModel
@{
    ViewData["Title"] = Model.City.Name;
    var sourceClass = Model.Weather.Source switch
    {
        "LIVE" => "source-live",
        "STALE" => "source-stale",
        _ => "source-cache"
    };
}

<a class="back-link" asp-action="Index">← Volver a mis ciudades</a>

<section class="detail-header">
    <div>
        <span class="eyebrow">@Model.City.CountryCode · @Model.City.Timezone</span>
        <h1>@Model.City.Name</h1>
        <p>@Model.City.Country · @Model.City.Latitude.ToString("0.000"), @Model.City.Longitude.ToString("0.000")</p>
    </div>
    <span class="source-badge @sourceClass">Origen: @Model.Weather.Source</span>
</section>

<section class="current-weather panel">
    <div class="temperature-block">
        <span class="weather-symbol" aria-hidden="true">☀</span>
        <div><strong>@Model.Weather.TemperatureC.ToString("0.0")°</strong><span>Temperatura actual</span></div>
    </div>
    <div class="metric-grid">
        <article><span>Humedad</span><strong>@Model.Weather.HumidityPercent%</strong></article>
        <article><span>Precipitación</span><strong>@Model.Weather.PrecipitationMm.ToString("0.0") mm</strong></article>
        <article><span>Viento</span><strong>@Model.Weather.WindSpeedKmh.ToString("0.0") km/h</strong></article>
        <article><span>Actualizado</span><strong>@Model.Weather.FetchedAtUtc.ToLocalTime().ToString("HH:mm")</strong></article>
    </div>
</section>

<section class="section-heading compact-heading">
    <div><span class="eyebrow">Próximos días</span><h2>Pronóstico</h2></div>
</section>
<div class="forecast-grid">
    @foreach (var day in Model.Weather.Daily)
    {
        <article class="forecast-card">
            <span>@day.Date</span>
            <strong>@day.MaximumC.ToString("0")°</strong>
            <small>Mín. @day.MinimumC.ToString("0")°</small>
            <small>@day.PrecipitationMm.ToString("0.0") mm lluvia</small>
        </article>
    }
</div>

<section class="panel alerts-panel">
    <div>
        <span class="eyebrow">Alertas meteorológicas</span>
        <h2>Alertas por umbral</h2>
        <p class="hint">
            Puede mantener hasta 5 alertas activas para esta ciudad.
        </p>
    </div>

    @* formulario para crear una alerta *@
    <form asp-action="CrearAlerta" method="post" data-lock-submit>
        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="NewAlert.FavoriteId"
               name="FavoriteId" />

        <div>
            <label for="alertMetric">Métrica</label>
            <select id="alertMetric"
                    asp-for="NewAlert.Metric"
                    name="Metric">
                <option value="1">Temperatura</option>
                <option value="2">Humedad</option>
                <option value="3">Precipitación</option>
                <option value="4">Viento</option>
            </select>
        </div>

        <div>
            <label for="alertOperator">Operador</label>
            <select id="alertOperator"
                    asp-for="NewAlert.Operator"
                    name="Operator">
                <option value="1">Mayor o igual (≥)</option>
                <option value="2">Menor o igual (≤)</option>
            </select>
        </div>

        <div>
            <label for="alertThreshold">Valor</label>
            <input id="alertThreshold"
                   asp-for="NewAlert.Threshold"
                   name="Threshold"
                   type="number"
                   step="0.1"
                   required />
        </div>

        <button class="button button-primary" type="submit">
            Crear alerta
        </button>
    </form>

    @* listado de alertas *@
    @if (Model.Alerts.Count == 0)
    {
        <p class="hint">
            No hay alertas configuradas para esta ciudad.
        </p>
    }
    else
    {
        <div class="alert-list">
            @foreach (var alert in Model.Alerts)
            {
                var metricName = alert.Metric switch
                {
                    WeatherMetric.TemperatureC => "Temperatura",
                    WeatherMetric.HumidityPercent => "Humedad",
                    WeatherMetric.PrecipitationMm => "Precipitación",
                    WeatherMetric.WindSpeedKmh => "Viento",
                    _ => "Métrica"
                };

                var operatorName =
                    alert.Operator == ThresholdOperator.GreaterThanOrEqual
                        ? "≥"
                        : "≤";

                var unit = alert.Metric switch
                {
                    WeatherMetric.TemperatureC => "°C",
                    WeatherMetric.HumidityPercent => "%",
                    WeatherMetric.PrecipitationMm => "mm",
                    WeatherMetric.WindSpeedKmh => "km/h",
                    _ => ""
                };

                <article class="panel">
                    <div>
                        <strong>
                            @metricName @operatorName @alert.Threshold.ToString("0.0") @unit
                        </strong>

                        <p>
                            Estado:
                            @if (!alert.IsEnabled)
                            {
                                <span>Desactivada</span>
                            }
                            else if (alert.IsTriggered)
                            {
                                <span>Disparada</span>
                            }
                            else
                            {
                                <span>Activa</span>
                            }
                        </p>

                        @if (alert.LastEvaluatedAtUtc.HasValue)
                        {
                            <small>
                                Evaluada:
                                @(alert.LastEvaluatedAtUtc.Value.ToLocalTime().ToString("dd-MM-yyyy HH:mm"))
                            </small>
                        }
                    </div>

                    <div>
                        <form asp-action="CambiarEstadoAlerta"
                              method="post"
                              data-lock-submit>
                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="favoriteId"
                                   value="@Model.City.Id" />

                            <input type="hidden"
                                   name="alertId"
                                   value="@alert.Id" />

                            <button class="button" type="submit">
                                @(alert.IsEnabled ? "Desactivar" : "Activar")
                            </button>
                        </form>

                        <form asp-action="EliminarAlerta"
                              method="post"
                              data-lock-submit
                              data-confirm="¿Eliminar esta alerta?">
                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="favoriteId"
                                   value="@Model.City.Id" />

                            <input type="hidden"
                                   name="alertId"
                                   value="@alert.Id" />

                            <button class="button button-danger" type="submit">
                                Eliminar
                            </button>
                        </form>
                    </div>
                </article>
            }
        </div>
    }
</section>

<div class="action-bar">
    <form asp-action="Refrescar" asp-route-id="@Model.City.Id" method="post" data-lock-submit>
        @Html.AntiForgeryToken()
        <button class="button button-primary" type="submit">Actualizar ahora</button>
    </form>
    <form asp-action="Eliminar" asp-route-id="@Model.City.Id" method="post" data-lock-submit data-confirm="¿Eliminar esta ciudad de sus favoritos?">
        @Html.AntiForgeryToken()
        <button class="button button-danger" type="submit">Eliminar favorito</button>
    </form>
</div>
